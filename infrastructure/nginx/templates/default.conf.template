server {
   listen 80;
   server_name ${NGINX_HOST} www.${NGINX_HOST};
   
   include /etc/nginx/includes/security.conf;

   set $ssl_enabled ${SSL_ENABLED};
   if ($ssl_enabled = "true") {
      return 301 https://$host$request_uri;
   }

   if ($host ~* ^www\.(.*)) {
      return 301 http://$1$request_uri;
   }

   include /etc/nginx/includes/csp.conf;

   # Locations
   include /etc/nginx/includes/locations-maintenance/error-page.conf;
   # include /etc/nginx/includes/locations-maintenance/monitoring.conf;
   include /etc/nginx/conf.d/locations/backend.conf;
   include /etc/nginx/conf.d/locations/frontend-admin.conf;
   include /etc/nginx/conf.d/locations/seaweedfs.conf;
   include /etc/nginx/conf.d/locations/public-assets.conf;

   include /etc/nginx/includes/performance.conf;
}