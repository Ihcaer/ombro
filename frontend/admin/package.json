{
  "name": "@ombro/frontend-admin-panel",
  "description": "Ombro Admin",
  "version": "0.0.1",
  "author": "Ihcaer (https://github.com/Ihcaer)",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "npm run generate-api",
    "serve": "npx nx serve admin-panel",
    "test": "npx nx run-many --target=test --all",
    "test:parallel": "nx run-many --target=test --all --parallel",
    "test:parallel:verb": "nx run-many --target=test --all --parallel --verbose",
    "test:affected": "npx nx affected --target=test",
    "test:affected:develop": "npx nx affected --target=test --base=develop",
    "test:watch": "npx nx run-many --target=test --all --watch",
    "test:e2e": "nx e2e admin-panel-e2e",
    "test:e2e:local:ui": "nx e2e admin-panel-e2e --ui --skip-nx-cache",
    "build:prod": "nx build admin-panel -c production --skip-nx-cache",
    "postbuild:prod": "nx run admin-panel:transloco:optimize",
    "generate-api": "nx run api-client:generate",
    "targets": "npx nx show project admin-panel"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.13",
    "@angular/common": "21.1.5",
    "@angular/compiler": "21.1.5",
    "@angular/core": "21.1.5",
    "@angular/forms": "21.1.5",
    "@angular/platform-browser": "21.1.5",
    "@angular/router": "21.1.5",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@jsverse/transloco-persist-lang": "^8.4.0",
    "@ngrx/operators": "^21.1.0",
    "@ngrx/signals": "^21.1.0",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-pl": "^4.1.1",
    "jwt-decode": "^4.0.0",
    "postcss": "^8.5.6",
    "primeng": "^21.1.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-primeui": "^0.6.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.1.3",
    "@analogjs/vitest-angular": "2.1.3",
    "@angular-devkit/core": "21.1.4",
    "@angular-devkit/schematics": "21.1.4",
    "@angular/build": "21.1.4",
    "@angular/cli": "21.1.4",
    "@angular/compiler-cli": "21.1.5",
    "@angular/language-service": "21.1.5",
    "@eslint/js": "^9.8.0",
    "@jsverse/transloco-optimize": "^8.4.0",
    "@ngrx/eslint-plugin": "^21.1.0",
    "@nx/angular": "22.5.2",
    "@nx/devkit": "22.5.2",
    "@nx/eslint": "22.5.2",
    "@nx/eslint-plugin": "22.5.2",
    "@nx/js": "22.5.2",
    "@nx/playwright": "22.5.2",
    "@nx/vite": "22.5.2",
    "@nx/vitest": "22.5.2",
    "@nx/web": "22.5.2",
    "@nx/workspace": "22.5.2",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "21.1.4",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.11",
    "@swc/helpers": "0.5.18",
    "@types/node": "^20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "angular-eslint": "21.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.5.2",
    "orval": "^8.24.0",
    "prettier": "~3.6.2",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.3.1",
    "vitest": "4.0.18"
  }
}
