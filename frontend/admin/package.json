{
  "name": "@ombro/frontend-admin-panel",
  "description": "Ombro Admin",
  "version": "0.0.1",
  "author": "Ihcaer (https://github.com/Ihcaer)",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "npm run generate-api",
    "serve": "npx nx serve admin-panel",
    "test": "npx nx run-many --target=test --all",
    "test:parallel": "nx run-many --target=test --all --parallel",
    "test:parallel:verb": "nx run-many --target=test --all --parallel --verbose",
    "test:affected": "npx nx affected --target=test",
    "test:affected:develop": "npx nx affected --target=test --base=develop",
    "test:watch": "npx nx run-many --target=test --all --watch",
    "test:e2e": "nx e2e admin-panel-e2e",
    "test:e2e:local:ui": "nx e2e admin-panel-e2e --ui --skip-nx-cache",
    "build:prod": "nx build admin-panel -c production --skip-nx-cache",
    "generate-api": "nx run api-client:generate",
    "targets": "npx nx show project admin-panel"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
