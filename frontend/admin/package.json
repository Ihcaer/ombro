    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-persist-lang": "^8.4.0",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@oxc-project/runtime": "^0.149.0",
    "@primeuix/themes": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-pl": "^4.1.1",
    "intl-messageformat": "^11.2.15",
    "jwt-decode": "^4.0.0",
    "postcss": "^8.5.28",
    "primeng": "^22.1.1",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "zone.js": "0.16.3"
  },
