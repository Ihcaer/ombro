{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2025",
    "module": "esnext",
    "lib": ["ES2025", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@ombro/themes": ["./libs/themes/src/index.ts"],
      "@ombro/shared/ui-icons": ["./libs/shared/ui-icons/src/index.ts"],
      "@ombro/shared/ui-forms": ["./libs/shared/ui-forms/src/index.ts"],
      "@ombro/shared/util-ui": ["./libs/shared/util-id/src/index.ts"],
      "@ombro/shared/breadcrumb": ["./libs/shared/breadcrumb/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
