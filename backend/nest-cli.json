{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": { "type": "swc", "options": { "swcrcPath": ".swcrc" } },
    "typeCheck": true,
    "assets": [
      {
        "include": "generated/prisma-client/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ],
    "watchAssets": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "dtoFileNameSuffix": [".dto.ts", ".dtos.ts"],
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  }
}
