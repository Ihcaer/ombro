// Enums

enum AuditVisibility {
  PUBLIC
  OWNER
  SYSTEM

  @@schema("audit")
}

enum AuditActorType {
  ADMIN
  SYSTEM
  CRON

  @@schema("audit")
}

// Models

model AuditLog {
  id         Int             @id @default(autoincrement())
  actorId    String?
  actorType  AuditActorType  @default(ADMIN)
  module     String
  action     String
  entityType String
  entityId   String
  visibility AuditVisibility @default(SYSTEM)
  changes    Json?
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([actorId, actorType, visibility, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([module, action, createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("audit")
}
